javascript:(function(){
  const fish="https://upload.wikimedia.org/wikipedia/commons/1/1c/Goldfish3.jpg";

  document.querySelectorAll("img").forEach(img=>{
    img.src = fish;
    img.srcset = "";
  });

  document.querySelectorAll("*").forEach(el=>{
    const style = window.getComputedStyle(el);
    if(style.backgroundImage !== "none"){
      el.style.backgroundImage = `url(${fish})`;
    }
  });
})();
